# Private per-user records — never committed (see CLAUDE.md §Privacy).
# Both patterns are needed: the trailing-slash form matches the real directory,
# the bare form matches the symlink used in the worktree setup (a symlink is not
# a directory to git, so the first pattern alone would let it be committed).
convos/*/private/
convos/*/private

# Local working files never committed: the error-injection review procedure
# (docs/procedures/code_review.md), and task-local notes such as scratch/vast_test_slow_hosts.txt
scratch/

# Secrets
.env

# Python
.venv/
__pycache__/

# OS noise
.DS_Store

# for now ignore logs (needs final decision in future)
/logs
# upstream InstrumentalEval main.py, downloaded and hash-checked by build_data.py; only parsed
data/input/InstrumentalEval_main.py.txt

# written by `ic-serve up`: model and connection settings of the current GPU session
serve_session.env
